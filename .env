PORT=5000
# ── Bot / Service Account ─────────────────────────────────────────────────────
# The Steem account that users will grant posting authority to.
# Users run account_update to add this account to their posting.account_auths.
# Then this bot signs votes on behalf of enrolled users using its OWN posting key.
BOT_ACCOUNT=votebd
BOT_POSTING_KEY=5J................................

# ── Trail Leader ──────────────────────────────────────────────────────────────
# The account whose votes are followed by all enrolled subscribers.
TRAIL_LEADER=dhaka.witness
